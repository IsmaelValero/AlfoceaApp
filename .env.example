# Project Settings → API en Supabase.
# Esta app NO usa DATABASE_URL ni el pooler de Postgres.

# Correcto: https://abcdefghijklmnop.supabase.co
# Incorrecto: URL del dashboard o postgresql://...
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# service_role (secret) en Project Settings → API. Token eyJ... completo.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Obligatorio en Vercel (Production). Cadena larga y aleatoria para firmar la cookie de sesion.
# Ejemplo: openssl rand -hex 32
ALFOCEA_SESSION_SECRET=cambia-esto-por-una-cadena-larga
